# ============================================================
# S.H.I.E.L.D. Platform — Environment Configuration
# Secure Server-Side Web Search & AI Chatbot API Credentials
# NEVER commit secret keys or environment files to git!
# ============================================================

# Port for standalone Express backend server
PORT=3001

# Web Search API Provider Key (Optional — e.g. Tavily / Serper / Custom Web Search API)
# If left blank, the backend falls back to built-in server-side educational web search.
WEB_SEARCH_API_KEY=

# Specific provider keys (if using Tavily or Serper directly)
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional LLM API Key (e.g. Gemini / OpenAI / Groq)
LLM_API_KEY=
